# ---- Supabase (paste from your Supabase project settings; never commit real values) ----
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service-role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Billing ----
# `stub` = DEV ONLY fake checkout (no real money, refuses in production
# unless DEMO_ALLOW_STUB=true on an explicit demo deploy).
# `stripe` = real gateway (guide: docs/STRIPE.md).
BILLING_PROVIDER=stub
# Stripe (only needed when BILLING_PROVIDER=stripe). Test keys start sk_test_,
# live keys sk_live_. Webhook secret comes from `stripe listen` (local dev)
# or the dashboard webhook endpoint (production). Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Demo ONLY: lets the stub checkout run on a production build so the client
# demo clicks end-to-end without a gateway. NEVER set on real production.
DEMO_ALLOW_STUB=

# ---- Renewal reminders (GET /api/cron/renewals) ----
# Long random string (e.g. `openssl rand -hex 32`). The scheduler calls the
# endpoint with `Authorization: Bearer <CRON_SECRET>`. No secret = no access.
CRON_SECRET=
# `log` (default) = print reminder emails to server logs, send nothing.
# `resend` = send via Resend (needs the two vars below).
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Boasis <portal@boasis.ae>
# ---- SMTP (only needed when EMAIL_PROVIDER=smtp, e.g. Google Workspace) ----
# SMTP_USER = full address (support@boasis.ae). SMTP_PASS = a Google App
# Password (NOT the normal login password). Same setup as boasis.ae forms.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
