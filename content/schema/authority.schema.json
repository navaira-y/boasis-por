{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boasis.ae/schemas/authority.json",
  "title": "Boasis authority deep-content file",
  "description": "One file per free zone / authority. Rules live here, never in code. Every rule carries a grade; unsourced rules MUST use grade=unknown plus whoCanAnswer.",
  "type": "object",
  "required": ["id", "version", "updated", "submissionChannel", "leaseAtRenewal", "renewalWindow", "renewsTogether", "ifLate", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "submissionChannel": {
      "type": "object",
      "required": ["type", "note", "grade"],
      "properties": {
        "type": { "enum": ["self", "partner-only", "zone-direct", "unknown"] },
        "note": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "grade": { "enum": ["confirmed", "reported", "unknown"] },
        "whoCanAnswer": { "type": "string" }
      }
    },
    "leaseAtRenewal": { "$ref": "#/$defs/ruleBlock" },
    "renewalWindow": { "$ref": "#/$defs/ruleBlock" },
    "renewsTogether": { "type": "array", "items": { "$ref": "#/$defs/sourcedItem" } },
    "ifLate": { "$ref": "#/$defs/ruleBlock" },
    "prefill": {
      "type": "object",
      "properties": {
        "visaQuotaByOfficeType": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["officeType", "allowed", "grade"],
            "properties": {
              "officeType": { "type": "string" },
              "allowed": { "type": "integer", "minimum": 0 },
              "grade": { "enum": ["confirmed", "reported", "unknown"] },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "ruleBlock": {
      "type": "object",
      "required": ["text", "grade"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "grade": { "enum": ["confirmed", "reported", "unknown"] },
        "whoCanAnswer": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "grade": { "const": "unknown" } } }, "then": { "required": ["whoCanAnswer"] } },
        { "if": { "properties": { "grade": { "enum": ["confirmed", "reported"] } } }, "then": { "required": ["source"] } }
      ]
    },
    "sourcedItem": {
      "type": "object",
      "required": ["item", "grade"],
      "properties": {
        "item": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "grade": { "enum": ["confirmed", "reported", "unknown"] }
      }
    }
  }
}
